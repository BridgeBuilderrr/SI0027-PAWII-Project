{
  "info": {
    "name": "PAWII - API NoSQL Data Modeling",
    "description": "Collection untuk testing CRUD API MongoDB pada project NoSQL Data Modeling. Endpoint yang dipakai sesuai struktur project saat ini.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Kategori",
      "item": [
        {
          "name": "GET Semua Kategori",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/kategori",
              "host": ["{{base_url}}"],
              "path": ["api", "kategori"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response berupa array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Tambah Kategori",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response memiliki message dan data', () => {",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body).to.have.property('data');",
                  "});",
                  "pm.environment.set('kategoriId', body.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Web Development\",\n  \"deskripsi\": \"Bahasa dan teknologi untuk membangun aplikasi web.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/kategori",
              "host": ["{{base_url}}"],
              "path": ["api", "kategori"]
            }
          }
        }
      ]
    },
    {
      "name": "Bahasa Program",
      "item": [
        {
          "name": "POST Tambah Bahasa Program",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('namaBahasa', 'JavaScript-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response memiliki data', () => pm.expect(body).to.have.property('data'));",
                  "pm.environment.set('bahasaProgramId', body.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"{{namaBahasa}}\",\n  \"kategori\": \"Web Development\",\n  \"dibuatOleh\": \"Brendan Eich\",\n  \"tahunRilis\": 1995,\n  \"level\": \"Pemula - Mahir\",\n  \"deskripsi\": \"Bahasa pemrograman yang digunakan untuk pengembangan web modern.\",\n  \"fiturUtama\": [\"Front-end\", \"Back-end\", \"Asynchronous Programming\"],\n  \"popularitas\": 98\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bahasa-program",
              "host": ["{{base_url}}"],
              "path": ["api", "bahasa-program"]
            }
          }
        },
        {
          "name": "GET Semua Bahasa Program",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response memiliki properti data', () => pm.expect(body).to.have.property('data'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bahasa-program?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "bahasa-program"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET Satu Bahasa Program",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('_id cocok', () => pm.expect(body._id).to.eql(pm.environment.get('bahasaProgramId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bahasa-program/{{bahasaProgramId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "bahasa-program", "{{bahasaProgramId}}"]
            }
          }
        },
        {
          "name": "PUT Update Bahasa Program",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Data berhasil diperbarui', () => pm.expect(body.data.popularitas).to.eql(100));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"popularitas\": 100\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bahasa-program/{{bahasaProgramId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "bahasa-program", "{{bahasaProgramId}}"]
            }
          }
        },
        {
          "name": "DELETE Hapus Bahasa Program",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response memiliki deletedData', () => pm.expect(body).to.have.property('deletedData'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bahasa-program/{{bahasaProgramId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "bahasa-program", "{{bahasaProgramId}}"]
            }
          }
        }
      ]
    }
  ]
}
